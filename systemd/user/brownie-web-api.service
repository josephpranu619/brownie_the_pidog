[Unit]
Description=Brownie web control API
After=brownie-bodyd.service brownie-mic.service
Wants=brownie-bodyd.service brownie-mic.service

[Service]
Type=simple
WorkingDirectory=/home/pranu/brownie_the_pidog
ExecStart=/home/pranu/brownie_the_pidog/app/backend/.venv/bin/uvicorn main:app --app-dir app/backend --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=default.target
