[Unit]
Description=Brownie web control Vite UI
After=brownie-web-api.service
Wants=brownie-web-api.service

[Service]
Type=simple
WorkingDirectory=/home/pranu/brownie_the_pidog/app/frontend
Environment=PATH=/home/pranu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/pranu/.local/bin/npm run dev -- --host 127.0.0.1
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=default.target
