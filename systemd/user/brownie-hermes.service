[Unit]
Description=Brownie Hermes voice assistant
After=brownie-mic.service brownie-bodyd.service
Requires=brownie-mic.service brownie-bodyd.service

[Service]
Type=simple
WorkingDirectory=/home/pranu/brownie_the_pidog
ExecStart=/bin/sh -c 'tail -f /dev/null | /usr/bin/script -qec "/home/pranu/.local/bin/hermes --cli" /dev/null'
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=default.target
