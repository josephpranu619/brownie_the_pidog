#!/usr/bin/env python3

import json
import os
import signal
import socket
import threading
import time
from pathlib import Path

SOCKET_PATH = Path("/tmp/brownie-body.sock")
MANUAL_LEASE_SECONDS = 8.0
HEAD_STEP_DEGREES = 20
HEAD_YAW_LIMIT_DEGREES = 40
HEAD_PITCH_MIN_DEGREES = -40
HEAD_PITCH_MAX_DEGREES = 30
HEAD_PITCH_OFFSET_DEGREES = 45
HEAD_SPEED = 80
HEAD_PINS = [4, 6, 5]
PIDOG_CONFIG_PATH = Path.home() / ".config/pidog/pidog.conf"

DOG = None
HEAD_ONLY = None
CURRENT_POSE = None
CURRENT_HEAD_YRP = [0, 0, 0]
MANUAL_LEASE_ID = None
MANUAL_LEASE_EXPIRES_AT = 0.0

# The RGB strip can be owned independently of the full Pidog object. This lets
# voice-state feedback work while Brownie's body remains passive, without
# initializing legs, IMU, sound direction, or sound effects just to light LEDs.
LED_STRIP = None
LED_THREAD = None
LED_THREAD_RUN = False
CURRENT_LED_MODE = "off"


def _apply_led_mode(strip, mode):
    if mode == "loading":
        strip.set_mode(
            "listen",
            color="cyan",
            bps=1.5,
            brightness=0.45,
        )
        return

    if mode == "off":
        strip.set_mode(
            "breath",
            color="black",
            bps=1,
            brightness=0,
        )
        return

    raise ValueError(f"Unsupported LED mode: {mode}")


def shutdown_led_only():
    """Release the standalone RGB-strip owner before full Pidog init or exit."""
    global LED_STRIP, LED_THREAD, LED_THREAD_RUN

    if LED_STRIP is None:
        return

    LED_THREAD_RUN = False
    if LED_THREAD is not None:
        LED_THREAD.join(timeout=1)

    try:
        LED_STRIP.close()
    except Exception:
        pass

    LED_STRIP = None
    LED_THREAD = None


def initialize_led_only():
    """Initialize only the RGB strip and its animation thread."""
    global LED_STRIP, LED_THREAD, LED_THREAD_RUN

    if DOG is not None and "rgb" in DOG.thread_list and hasattr(DOG, "rgb_strip"):
        return DOG.rgb_strip

    if LED_STRIP is not None:
        return LED_STRIP

    from pidog.rgb_strip import RGBStrip

    LED_STRIP = RGBStrip(addr=0x74, nums=11)
    _apply_led_mode(LED_STRIP, CURRENT_LED_MODE)
    LED_THREAD_RUN = True

    def _run_led_strip():
        while LED_THREAD_RUN:
            try:
                LED_STRIP.show()
            except Exception as exc:
                print(f"LED-ONLY ERROR: {exc}", flush=True)
                time.sleep(0.1)

    LED_THREAD = threading.Thread(
        name="brownie-led-only",
        target=_run_led_strip,
        daemon=True,
    )
    LED_THREAD.start()
    print("LED-ONLY MODE: RGB strip initialized without full Pidog hardware.", flush=True)
    return LED_STRIP


def set_led_mode(mode):
    global CURRENT_LED_MODE

    if mode not in {"loading", "off"}:
        raise ValueError(f"Unsupported LED mode: {mode}")

    # Do not wake the I2C LED device merely to keep an already-dark passive
    # robot dark. The first visible mode will initialize it when needed.
    if mode == "off" and DOG is None and LED_STRIP is None:
        CURRENT_LED_MODE = "off"
        return

    strip = (
        DOG.rgb_strip
        if DOG is not None and "rgb" in DOG.thread_list and hasattr(DOG, "rgb_strip")
        else initialize_led_only()
    )
    _apply_led_mode(strip, mode)
    CURRENT_LED_MODE = mode



def release_head_only():
    """Release Brownie's lightweight head-only software owner."""
    global HEAD_ONLY
    HEAD_ONLY = None


def initialize_head_only():
    """Initialize only the three neck servos without waking Brownie's body."""
    global HEAD_ONLY

    if DOG is not None:
        return DOG.head

    if HEAD_ONLY is not None:
        return HEAD_ONLY

    from robot_hat import Robot

    raw_angles = [
        CURRENT_HEAD_YRP[0],
        CURRENT_HEAD_YRP[1],
        CURRENT_HEAD_YRP[2] + HEAD_PITCH_OFFSET_DEGREES,
    ]

    HEAD_ONLY = Robot(
        pin_list=HEAD_PINS,
        name="head",
        init_angles=raw_angles,
        db=str(PIDOG_CONFIG_PATH),
    )
    HEAD_ONLY.max_dps = 300

    print("HEAD-ONLY MODE: neck servos initialized without full Pidog hardware.", flush=True)
    return HEAD_ONLY


def move_head_to_current():
    """Move through the full Pidog owner when present, otherwise head-only."""
    if DOG is not None:
        DOG.head_move(
            [list(CURRENT_HEAD_YRP)],
            immediately=True,
            speed=HEAD_SPEED,
        )
        return

    head = initialize_head_only()
    raw_angles = [
        CURRENT_HEAD_YRP[0],
        CURRENT_HEAD_YRP[1],
        CURRENT_HEAD_YRP[2] + HEAD_PITCH_OFFSET_DEGREES,
    ]
    head.servo_move(raw_angles, speed=HEAD_SPEED)


def initialize_body_to_pose(pose):
    """
    Create one persistent Pidog instance directly in the explicitly requested pose.
    This function is NOT called automatically.
    """
    global DOG, CURRENT_POSE

    if DOG is not None:
        return

    if pose not in {"stand", "sit", "lie"}:
        raise ValueError(f"Unsupported initial pose: {pose}")

    # The full Pidog object creates its own RGBStrip instance. Release any
    # standalone LED-only owner first so there is always exactly one I2C owner.
    desired_led_mode = CURRENT_LED_MODE
    desired_head_yrp = list(CURRENT_HEAD_YRP)
    shutdown_led_only()
    release_head_only()

    from pidog import Pidog
    from pidog.actions_dictionary import ActionDict

    actions = ActionDict()
    leg_frames, part = actions[pose]

    if part != "legs" or not leg_frames:
        raise RuntimeError(f"Invalid leg action for initial pose: {pose}")

    DOG = Pidog(
        leg_init_angles=list(leg_frames[0]),
        head_init_angles=desired_head_yrp,
        tail_init_angle=[0],
    )
    CURRENT_POSE = pose

    if "rgb" in DOG.thread_list and hasattr(DOG, "rgb_strip"):
        _apply_led_mode(DOG.rgb_strip, desired_led_mode)


def body_initialized():
    return DOG is not None


def read_battery_voltage():
    try:
        from robot_hat import device

        return round(float(device.get_battery_voltage()), 2)
    except Exception:
        return None


def read_distance_cm():
    """Take one ultrasonic measurement without creating a second Pidog instance."""
    if DOG is not None:
        try:
            value = float(DOG.read_distance())
            return round(value, 1) if value > 0 else None
        except Exception:
            return None

    from robot_hat import Pin, Ultrasonic

    echo = Pin("D0")
    trig = Pin("D1")
    ultrasonic = Ultrasonic(trig, echo, timeout=0.017)

    try:
        value = float(ultrasonic.read())
        return round(value, 1) if value > 0 else None
    finally:
        ultrasonic.close()


def clear_manual_lease():
    global MANUAL_LEASE_ID, MANUAL_LEASE_EXPIRES_AT

    MANUAL_LEASE_ID = None
    MANUAL_LEASE_EXPIRES_AT = 0.0


def manual_lease_active():
    if MANUAL_LEASE_ID is None:
        return False

    if time.monotonic() >= MANUAL_LEASE_EXPIRES_AT:
        clear_manual_lease()
        return False

    return True


def manual_lease_owned_by(lease_id):
    return bool(lease_id) and manual_lease_active() and MANUAL_LEASE_ID == lease_id


def renew_manual_lease(lease_id):
    """Refresh a lease after a command that may temporarily block socket servicing."""
    global MANUAL_LEASE_EXPIRES_AT

    if lease_id and MANUAL_LEASE_ID == lease_id:
        MANUAL_LEASE_EXPIRES_AT = time.monotonic() + MANUAL_LEASE_SECONDS
        return True

    return False


def control_state():
    active = manual_lease_active()
    remaining = max(0.0, MANUAL_LEASE_EXPIRES_AT - time.monotonic()) if active else 0.0

    return {
        "control_mode": "manual" if active else "autonomous",
        "manual_lease_active": active,
        "manual_lease_remaining_s": round(remaining, 1),
    }


def acquire_manual_lease(lease_id):
    global MANUAL_LEASE_ID, MANUAL_LEASE_EXPIRES_AT

    if not lease_id:
        return {"ok": False, "error": "Manual lease id is required."}

    if manual_lease_active() and MANUAL_LEASE_ID != lease_id:
        return {
            "ok": False,
            "error": "Manual control is already held by another client.",
            **control_state(),
        }

    MANUAL_LEASE_ID = lease_id
    MANUAL_LEASE_EXPIRES_AT = time.monotonic() + MANUAL_LEASE_SECONDS

    return {
        "ok": True,
        **control_state(),
    }


def heartbeat_manual_lease(lease_id):
    global MANUAL_LEASE_EXPIRES_AT

    if not manual_lease_active() or MANUAL_LEASE_ID != lease_id:
        return {
            "ok": False,
            "error": "Manual control lease is not active for this client.",
            **control_state(),
        }

    MANUAL_LEASE_EXPIRES_AT = time.monotonic() + MANUAL_LEASE_SECONDS

    return {
        "ok": True,
        **control_state(),
    }


def release_manual_lease(lease_id):
    if manual_lease_active() and MANUAL_LEASE_ID != lease_id:
        return {
            "ok": False,
            "error": "Manual control lease belongs to another client.",
            **control_state(),
        }

    clear_manual_lease()
    return {
        "ok": True,
        **control_state(),
    }


def shutdown_body_preserve_posture():
    """
    Stop PiDog worker threads and peripherals without calling Pidog.close(),
    because Pidog.close() explicitly calls stop_and_lie().
    """
    global DOG

    if DOG is None:
        return

    dog = DOG

    dog.exit_flag = True
    dog._sensory_exit_flag = True

    if "rgb" in dog.thread_list:
        dog.rgb_thread_run = False

    for name in ("legs_thread", "head_thread", "tail_thread", "imu_thread"):
        thread = getattr(dog, name, None)
        if thread is not None:
            thread.join(timeout=2)

    rgb_thread = getattr(dog, "rgb_strip_thread", None)
    if rgb_thread is not None:
        rgb_thread.join(timeout=2)

    sensory_thread = getattr(dog, "sensory_process", None)
    if sensory_thread is not None:
        sensory_thread.join(timeout=2)

    for name in ("dual_touch", "ears", "ultrasonic", "rgb_strip"):
        device = getattr(dog, name, None)
        close = getattr(device, "close", None)
        if callable(close):
            try:
                close()
            except Exception:
                pass

    DOG = None


def handle(command):
    global CURRENT_POSE

    verb, _, argument = command.partition(" ")
    argument = argument.strip()

    if verb == "control-status":
        return {
            "ok": True,
            **control_state(),
        }

    if verb == "manual-acquire":
        return acquire_manual_lease(argument)

    if verb == "manual-heartbeat":
        return heartbeat_manual_lease(argument)

    if verb == "manual-release":
        return release_manual_lease(argument)

    if command == "status":
        return {
            "ok": True,
            "body_initialized": body_initialized(),
            "head_initialized": body_initialized() or HEAD_ONLY is not None,
            "pose": CURRENT_POSE,
            "head_yrp": list(CURRENT_HEAD_YRP),
            "battery_voltage": read_battery_voltage(),
            "led_mode": CURRENT_LED_MODE,
            **control_state(),
            "message": (
                "Brownie body controller owns the body."
                if body_initialized()
                else "Brownie body controller is running passively."
            ),
        }

    if command == "distance":
        try:
            return {
                "ok": True,
                "distance_cm": read_distance_cm(),
            }
        except Exception as exc:
            return {
                "ok": False,
                "error": f"Distance read failed: {exc}",
            }

    if verb == "stand":
        if not manual_lease_owned_by(argument):
            return {
                "ok": False,
                "error": "Stand requires the active manual-control lease for this client.",
                **control_state(),
            }

        if not body_initialized():
            initialize_body_to_pose("stand")
            message = "Brownie body initialized directly into stand posture."
        else:
            DOG.body_stop()
            DOG.do_action("stand", speed=70)
            CURRENT_POSE = "stand"
            message = "Brownie started moving to stand posture."

        renew_manual_lease(argument)

        return {
            "ok": True,
            "body_initialized": True,
            "pose": "stand",
            **control_state(),
            "message": message,
        }

    if verb == "sit":
        if not manual_lease_owned_by(argument):
            return {
                "ok": False,
                "error": "Sit requires the active manual-control lease for this client.",
                **control_state(),
            }

        if not body_initialized():
            return {
                "ok": False,
                "error": "Body must already be initialized before sit is enabled.",
                **control_state(),
            }

        DOG.body_stop()
        DOG.do_action("sit", speed=70)
        CURRENT_POSE = "sit"
        renew_manual_lease(argument)

        return {
            "ok": True,
            "body_initialized": True,
            "pose": "sit",
            **control_state(),
            "message": "Brownie started moving to sit posture.",
        }

    if verb == "lie":
        if not manual_lease_owned_by(argument):
            return {
                "ok": False,
                "error": "Lie requires the active manual-control lease for this client.",
                **control_state(),
            }

        if not body_initialized():
            initialize_body_to_pose("lie")
            message = "Brownie body initialized directly into lie posture."
        else:
            DOG.body_stop()
            DOG.do_action("lie", speed=70)
            CURRENT_POSE = "lie"
            message = "Brownie started moving to lie posture."

        renew_manual_lease(argument)

        return {
            "ok": True,
            "body_initialized": True,
            "pose": "lie",
            **control_state(),
            "message": message,
        }

    if verb == "move":
        parts = argument.split()
        if len(parts) < 2:
            return {
                "ok": False,
                "error": "Body movement command is missing lease or direction.",
                **control_state(),
            }

        lease_id = parts[0]
        direction = parts[1]

        try:
            speed = int(parts[2]) if len(parts) >= 3 else 80
        except ValueError:
            return {
                "ok": False,
                "error": "Movement speed must be an integer.",
                **control_state(),
            }

        if not 30 <= speed <= 100:
            return {
                "ok": False,
                "error": "Movement speed must be between 30 and 100.",
                **control_state(),
            }

        if not manual_lease_owned_by(lease_id):
            return {
                "ok": False,
                "error": "Body movement requires the active manual-control lease for this client.",
                **control_state(),
            }

        if not body_initialized() or CURRENT_POSE != "stand":
            return {
                "ok": False,
                "error": "Brownie must be standing before body movement is enabled.",
                **control_state(),
            }

        if not DOG.is_legs_done():
            return {
                "ok": False,
                "error": "Brownie's legs are still completing the previous motion.",
                **control_state(),
            }

        actions = {
            "up": "forward",
            "down": "backward",
            "left": "turn_left",
            "right": "turn_right",
        }
        action = actions.get(direction)

        if action is None:
            return {
                "ok": False,
                "error": f"Unsupported body direction: {direction}",
                **control_state(),
            }

        DOG.body_stop()
        DOG.do_action(action, speed=speed)
        renew_manual_lease(lease_id)

        return {
            "ok": True,
            "body_initialized": True,
            "pose": "stand",
            "direction": direction,
            "speed": speed,
            **control_state(),
            "message": f"Brownie started one {action} gait action at speed {speed}.",
        }

    if verb == "head":
        parts = argument.split()
        if len(parts) < 2:
            return {
                "ok": False,
                "error": "Head movement command is missing lease or direction.",
                **control_state(),
            }

        lease_id = parts[0]
        direction = parts[1]

        if direction not in {"up", "down", "left", "right"}:
            return {
                "ok": False,
                "error": f"Unsupported head direction: {direction}",
                **control_state(),
            }

        if not manual_lease_owned_by(lease_id):
            return {
                "ok": False,
                "error": "Head movement requires the active manual-control lease for this client.",
                **control_state(),
            }

        if direction == "up":
            CURRENT_HEAD_YRP[2] = min(
                HEAD_PITCH_MAX_DEGREES,
                CURRENT_HEAD_YRP[2] + HEAD_STEP_DEGREES,
            )
        elif direction == "down":
            CURRENT_HEAD_YRP[2] = max(
                HEAD_PITCH_MIN_DEGREES,
                CURRENT_HEAD_YRP[2] - HEAD_STEP_DEGREES,
            )
        elif direction == "left":
            CURRENT_HEAD_YRP[0] = min(
                HEAD_YAW_LIMIT_DEGREES,
                CURRENT_HEAD_YRP[0] + HEAD_STEP_DEGREES,
            )
        else:
            CURRENT_HEAD_YRP[0] = max(
                -HEAD_YAW_LIMIT_DEGREES,
                CURRENT_HEAD_YRP[0] - HEAD_STEP_DEGREES,
            )

        move_head_to_current()
        renew_manual_lease(lease_id)

        return {
            "ok": True,
            "body_initialized": body_initialized(),
            "head_initialized": True,
            "pose": CURRENT_POSE,
            "direction": direction,
            "head_yrp": list(CURRENT_HEAD_YRP),
            "speed": HEAD_SPEED,
            **control_state(),
            "message": f"Brownie head moved {direction} to {CURRENT_HEAD_YRP}.",
        }

    if verb == "led":
        if argument not in {"loading", "off"}:
            return {
                "ok": False,
                "error": f"Unsupported LED mode: {argument}",
                **control_state(),
            }

        try:
            set_led_mode(argument)
        except Exception as exc:
            return {
                "ok": False,
                "error": f"LED control failed: {exc}",
                **control_state(),
            }

        return {
            "ok": True,
            "led_mode": argument,
            **control_state(),
            "message": (
                "Brownie LED listening pattern enabled."
                if argument == "loading"
                else "Brownie LEDs turned off."
            ),
        }

    if verb == "stop":
        if body_initialized():
            DOG.body_stop()
            DOG.head_stop()

        return {
            "ok": True,
            "body_initialized": body_initialized(),
            "pose": CURRENT_POSE,
            **control_state(),
            "message": (
                "Brownie body and head motion stopped."
                if body_initialized()
                else "Brownie body is passive; no body motion to stop."
            ),
        }

    return {
        "ok": False,
        "error": f"Unsupported command: {command}",
    }


def main():
    def handle_shutdown_signal(signum, frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, handle_shutdown_signal)

    if SOCKET_PATH.exists():
        SOCKET_PATH.unlink()

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(SOCKET_PATH))
    os.chmod(SOCKET_PATH, 0o600)
    server.listen(1)

    print(f"Brownie body controller listening on {SOCKET_PATH}")
    print("PASSIVE MODE: PiDog hardware has not been initialized.")
    print(f"CONTROL MODE: autonomous by default; manual lease timeout {MANUAL_LEASE_SECONDS:.0f}s.")

    try:
        while True:
            conn, _ = server.accept()

            with conn:
                try:
                    data = conn.recv(4096).decode().strip()
                    verb = data.partition(" ")[0]
                    quiet_command = (
                        data in {"status", "distance", "control-status"}
                        or verb == "manual-heartbeat"
                    )
                    if not quiet_command:
                        safe_label = verb if verb in {
                            "manual-acquire", "manual-release", "stand", "sit", "lie", "move", "head", "led"
                        } else data
                        print(f"COMMAND: {safe_label!r}", flush=True)
                    response = handle(data)
                    conn.sendall((json.dumps(response) + "\n").encode())
                except OSError as exc:
                    print(f"CLIENT SOCKET CLOSED: {exc}", flush=True)

    except KeyboardInterrupt:
        print("\nStopping Brownie body controller.")

    finally:
        clear_manual_lease()
        try:
            set_led_mode("off")
        except Exception:
            pass
        shutdown_led_only()
        release_head_only()
        shutdown_body_preserve_posture()

        server.close()

        if SOCKET_PATH.exists():
            SOCKET_PATH.unlink()


if __name__ == "__main__":
    main()
