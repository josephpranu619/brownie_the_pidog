#!/usr/bin/env python3

import json
import os
import signal
import socket
import time
from pathlib import Path

SOCKET_PATH = Path("/tmp/brownie-body.sock")
MANUAL_LEASE_SECONDS = 8.0

DOG = None
CURRENT_POSE = None
MANUAL_LEASE_ID = None
MANUAL_LEASE_EXPIRES_AT = 0.0


def initialize_body_to_pose(pose):
    """
    Create one persistent Pidog instance directly in the explicitly requested pose.
    This function is NOT called automatically.
    """
    global DOG, CURRENT_POSE

    if DOG is not None:
        return

    if pose not in {"stand", "sit", "lie"}:
        raise ValueError(f"Unsupported initial pose: {pose}")

    from pidog import Pidog
    from pidog.actions_dictionary import ActionDict

    actions = ActionDict()
    leg_frames, part = actions[pose]

    if part != "legs" or not leg_frames:
        raise RuntimeError(f"Invalid leg action for initial pose: {pose}")

    DOG = Pidog(
        leg_init_angles=list(leg_frames[0]),
        head_init_angles=[0, 0, 0],
        tail_init_angle=[0],
    )
    CURRENT_POSE = pose


def body_initialized():
    return DOG is not None


def read_battery_voltage():
    try:
        from robot_hat import device

        return round(float(device.get_battery_voltage()), 2)
    except Exception:
        return None


def read_distance_cm():
    """Take one ultrasonic measurement without creating a second Pidog instance."""
    if DOG is not None:
        try:
            value = float(DOG.ultrasonic.read_distance())
            return round(value, 1) if value > 0 else None
        except Exception:
            return None

    from robot_hat import Pin, Ultrasonic

    echo = Pin("D0")
    trig = Pin("D1")
    ultrasonic = Ultrasonic(trig, echo, timeout=0.017)

    try:
        value = float(ultrasonic.read())
        return round(value, 1) if value > 0 else None
    finally:
        ultrasonic.close()


def clear_manual_lease():
    global MANUAL_LEASE_ID, MANUAL_LEASE_EXPIRES_AT

    MANUAL_LEASE_ID = None
    MANUAL_LEASE_EXPIRES_AT = 0.0


def manual_lease_active():
    if MANUAL_LEASE_ID is None:
        return False

    if time.monotonic() >= MANUAL_LEASE_EXPIRES_AT:
        clear_manual_lease()
        return False

    return True


def manual_lease_owned_by(lease_id):
    return bool(lease_id) and manual_lease_active() and MANUAL_LEASE_ID == lease_id


def renew_manual_lease(lease_id):
    """Refresh a lease after a command that may temporarily block socket servicing."""
    global MANUAL_LEASE_EXPIRES_AT

    if lease_id and MANUAL_LEASE_ID == lease_id:
        MANUAL_LEASE_EXPIRES_AT = time.monotonic() + MANUAL_LEASE_SECONDS
        return True

    return False


def control_state():
    active = manual_lease_active()
    remaining = max(0.0, MANUAL_LEASE_EXPIRES_AT - time.monotonic()) if active else 0.0

    return {
        "control_mode": "manual" if active else "autonomous",
        "manual_lease_active": active,
        "manual_lease_remaining_s": round(remaining, 1),
    }


def acquire_manual_lease(lease_id):
    global MANUAL_LEASE_ID, MANUAL_LEASE_EXPIRES_AT

    if not lease_id:
        return {"ok": False, "error": "Manual lease id is required."}

    if manual_lease_active() and MANUAL_LEASE_ID != lease_id:
        return {
            "ok": False,
            "error": "Manual control is already held by another client.",
            **control_state(),
        }

    MANUAL_LEASE_ID = lease_id
    MANUAL_LEASE_EXPIRES_AT = time.monotonic() + MANUAL_LEASE_SECONDS

    return {
        "ok": True,
        **control_state(),
    }


def heartbeat_manual_lease(lease_id):
    global MANUAL_LEASE_EXPIRES_AT

    if not manual_lease_active() or MANUAL_LEASE_ID != lease_id:
        return {
            "ok": False,
            "error": "Manual control lease is not active for this client.",
            **control_state(),
        }

    MANUAL_LEASE_EXPIRES_AT = time.monotonic() + MANUAL_LEASE_SECONDS

    return {
        "ok": True,
        **control_state(),
    }


def release_manual_lease(lease_id):
    if manual_lease_active() and MANUAL_LEASE_ID != lease_id:
        return {
            "ok": False,
            "error": "Manual control lease belongs to another client.",
            **control_state(),
        }

    clear_manual_lease()
    return {
        "ok": True,
        **control_state(),
    }


def shutdown_body_preserve_posture():
    """
    Stop PiDog worker threads and peripherals without calling Pidog.close(),
    because Pidog.close() explicitly calls stop_and_lie().
    """
    global DOG

    if DOG is None:
        return

    dog = DOG

    dog.exit_flag = True
    dog._sensory_exit_flag = True

    if "rgb" in dog.thread_list:
        dog.rgb_thread_run = False

    for name in ("legs_thread", "head_thread", "tail_thread", "imu_thread"):
        thread = getattr(dog, name, None)
        if thread is not None:
            thread.join(timeout=2)

    rgb_thread = getattr(dog, "rgb_strip_thread", None)
    if rgb_thread is not None:
        rgb_thread.join(timeout=2)

    sensory_thread = getattr(dog, "sensory_process", None)
    if sensory_thread is not None:
        sensory_thread.join(timeout=2)

    for name in ("dual_touch", "ears", "ultrasonic", "rgb_strip"):
        device = getattr(dog, name, None)
        close = getattr(device, "close", None)
        if callable(close):
            try:
                close()
            except Exception:
                pass

    DOG = None


def handle(command):
    global CURRENT_POSE

    verb, _, argument = command.partition(" ")
    argument = argument.strip()

    if verb == "control-status":
        return {
            "ok": True,
            **control_state(),
        }

    if verb == "manual-acquire":
        return acquire_manual_lease(argument)

    if verb == "manual-heartbeat":
        return heartbeat_manual_lease(argument)

    if verb == "manual-release":
        return release_manual_lease(argument)

    if command == "status":
        return {
            "ok": True,
            "body_initialized": body_initialized(),
            "pose": CURRENT_POSE,
            "battery_voltage": read_battery_voltage(),
            **control_state(),
            "message": (
                "Brownie body controller owns the body."
                if body_initialized()
                else "Brownie body controller is running passively."
            ),
        }

    if command == "distance":
        try:
            return {
                "ok": True,
                "distance_cm": read_distance_cm(),
            }
        except Exception as exc:
            return {
                "ok": False,
                "error": f"Distance read failed: {exc}",
            }

    if verb == "stand":
        if not manual_lease_owned_by(argument):
            return {
                "ok": False,
                "error": "Stand requires the active manual-control lease for this client.",
                **control_state(),
            }

        if not body_initialized():
            initialize_body_to_pose("stand")
            message = "Brownie body initialized directly into stand posture."
        else:
            DOG.body_stop()
            DOG.do_action("stand", speed=70)
            CURRENT_POSE = "stand"
            message = "Brownie started moving to stand posture."

        renew_manual_lease(argument)

        return {
            "ok": True,
            "body_initialized": True,
            "pose": "stand",
            **control_state(),
            "message": message,
        }

    if verb == "sit":
        if not manual_lease_owned_by(argument):
            return {
                "ok": False,
                "error": "Sit requires the active manual-control lease for this client.",
                **control_state(),
            }

        if not body_initialized():
            return {
                "ok": False,
                "error": "Body must already be initialized before sit is enabled.",
                **control_state(),
            }

        DOG.body_stop()
        DOG.do_action("sit", speed=70)
        CURRENT_POSE = "sit"
        renew_manual_lease(argument)

        return {
            "ok": True,
            "body_initialized": True,
            "pose": "sit",
            **control_state(),
            "message": "Brownie started moving to sit posture.",
        }

    if verb == "lie":
        if not manual_lease_owned_by(argument):
            return {
                "ok": False,
                "error": "Lie requires the active manual-control lease for this client.",
                **control_state(),
            }

        if not body_initialized():
            initialize_body_to_pose("lie")
            message = "Brownie body initialized directly into lie posture."
        else:
            DOG.body_stop()
            DOG.do_action("lie", speed=70)
            CURRENT_POSE = "lie"
            message = "Brownie started moving to lie posture."

        renew_manual_lease(argument)

        return {
            "ok": True,
            "body_initialized": True,
            "pose": "lie",
            **control_state(),
            "message": message,
        }

    if verb == "stop":
        if body_initialized():
            DOG.body_stop()

        return {
            "ok": True,
            "body_initialized": body_initialized(),
            "pose": CURRENT_POSE,
            **control_state(),
            "message": (
                "Brownie body motion stopped."
                if body_initialized()
                else "Brownie body is passive; no body motion to stop."
            ),
        }

    if verb == "walk":
        return {
            "ok": False,
            "error": "walk is not enabled yet.",
        }

    return {
        "ok": False,
        "error": f"Unsupported command: {command}",
    }


def main():
    def handle_shutdown_signal(signum, frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, handle_shutdown_signal)

    if SOCKET_PATH.exists():
        SOCKET_PATH.unlink()

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(SOCKET_PATH))
    os.chmod(SOCKET_PATH, 0o600)
    server.listen(1)

    print(f"Brownie body controller listening on {SOCKET_PATH}")
    print("PASSIVE MODE: PiDog hardware has not been initialized.")
    print(f"CONTROL MODE: autonomous by default; manual lease timeout {MANUAL_LEASE_SECONDS:.0f}s.")

    try:
        while True:
            conn, _ = server.accept()

            with conn:
                try:
                    data = conn.recv(4096).decode().strip()
                    verb = data.partition(" ")[0]
                    quiet_command = (
                        data in {"status", "distance", "control-status"}
                        or verb == "manual-heartbeat"
                    )
                    if not quiet_command:
                        safe_label = verb if verb in {
                            "manual-acquire", "manual-release", "stand", "sit", "lie"
                        } else data
                        print(f"COMMAND: {safe_label!r}", flush=True)
                    response = handle(data)
                    conn.sendall((json.dumps(response) + "\n").encode())
                except OSError as exc:
                    print(f"CLIENT SOCKET CLOSED: {exc}", flush=True)

    except KeyboardInterrupt:
        print("\nStopping Brownie body controller.")

    finally:
        clear_manual_lease()
        shutdown_body_preserve_posture()

        server.close()

        if SOCKET_PATH.exists():
            SOCKET_PATH.unlink()


if __name__ == "__main__":
    main()
