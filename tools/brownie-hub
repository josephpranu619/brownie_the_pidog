#!/usr/bin/env python3

import subprocess
from pathlib import Path

HERE = Path(__file__).resolve().parent

TOOLS = {
    "1. Brownie Controls": HERE / "brownie",
    "2. Brownie Behaviors": HERE / "brownie-behaviors",
}


def choose():
    p = subprocess.run(
        [
            "fzf",
            "--height=60%",
            "--layout=reverse",
            "--border=rounded",
            "--prompt=Brownie Hub > ",
            "--pointer=▶",
            "--header=Select a Brownie tool • Enter to open • Esc to exit",
        ],
        input="\n".join(TOOLS.keys()),
        text=True,
        stdout=subprocess.PIPE,
    )

    if p.returncode != 0:
        return None

    return p.stdout.strip()


def main():
    while True:
        selection = choose()

        if not selection:
            break

        tool = TOOLS[selection]

        subprocess.run([str(tool)])


if __name__ == "__main__":
    main()
