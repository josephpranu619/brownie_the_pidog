#!/usr/bin/env python3

import subprocess


def hermes_get(key):
    p = subprocess.run(
        ["hermes", "config", "get", key],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    return p.stdout.strip()


def pause():
    input("\nPress Enter to return...")


def show_current():
    duration = hermes_get("voice.silence_duration")
    threshold = hermes_get("voice.silence_threshold")

    print("\nBrownie Voice Tuning")
    print("--------------------")
    print(f"Silence duration : {duration} seconds")
    print(f"Silence threshold: {threshold}")
    print()
    print("silence_duration:")
    print("  How long audio must remain quiet before Hermes stops listening.")
    print()
    print("silence_threshold:")
    print("  RMS level below which Hermes considers audio to be silence.")
    print("  Higher values tolerate more background noise as silence.")

    pause()


def set_value(key, label, guidance):
    current = hermes_get(key)

    print(f"\n{label}")
    print("-" * len(label))
    print(f"Current value: {current}")
    print()
    print(guidance)
    print()

    value = input("Enter new value, or press Enter to cancel: ").strip()

    if not value:
        print("Cancelled.")
        pause()
        return

    print()
    subprocess.run(["hermes", "config", "set", key, value])
    print(f"\nNew value: {hermes_get(key)}")

    pause()


def get_speaker_volume():
    p = subprocess.run(
        ["amixer", "-c", "1", "sget", "robot-hat speaker"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )

    for line in p.stdout.splitlines():
        if "Front Left:" in line and "[" in line and "%]" in line:
            start = line.find("[") + 1
            end = line.find("%]", start)
            if start > 0 and end > start:
                return int(line[start:end])

    return None


def show_speaker():
    volume = get_speaker_volume()

    print("\nBrownie Speaker Volume")
    print("----------------------")

    if volume is None:
        print("Unable to read speaker volume.")
    else:
        print(f"Current volume: {volume}%")

    print()
    print("This controls the Robot HAT hardware speaker output.")
    print("0% = silent")
    print("100% = maximum hardware volume")

    pause()


def set_speaker():
    current = get_speaker_volume()

    print("\nSet Brownie Speaker Volume")
    print("--------------------------")
    print(f"Current volume: {current if current is not None else 'unknown'}%")
    print()
    print("Enter a value from 0 to 100.")

    value = input("New speaker volume (%), or Enter to cancel: ").strip()

    if not value:
        print("Cancelled.")
        pause()
        return

    try:
        volume = int(value)
    except ValueError:
        print("Invalid value. Enter a whole number from 0 to 100.")
        pause()
        return

    if not 0 <= volume <= 100:
        print("Invalid value. Volume must be between 0 and 100.")
        pause()
        return

    subprocess.run(
        ["amixer", "-c", "1", "sset", "robot-hat speaker", f"{volume}%"],
        check=False,
        stdout=subprocess.DEVNULL,
    )

    updated = get_speaker_volume()
    print(f"\nNew speaker volume: {updated}%")

    pause()


def show_mic():
    print("\nCurrent PulseAudio default source")
    print("---------------------------------")

    subprocess.run(
        ["pactl", "get-default-source"],
        check=False,
    )

    print()
    subprocess.run(
        ["pactl", "list", "short", "sources"],
        check=False,
    )

    pause()


def choose():
    items = [
        "📊  Show current voice tuning",
        "⏱️   Set silence duration",
        "🎤  Set silence threshold",
        "🔊  Show speaker volume",
        "🔉  Set speaker volume",
        "🎚️   Show microphone source",
        "🚪  Back",
    ]

    p = subprocess.run(
        [
            "fzf",
            "--height=70%",
            "--layout=reverse",
            "--border=rounded",
            "--prompt=Brownie Tuning > ",
            "--pointer=▶",
            "--header=Select a parameter • Enter to open • Esc to return",
        ],
        input="\n".join(items),
        text=True,
        stdout=subprocess.PIPE,
    )

    if p.returncode != 0:
        return None

    return p.stdout.strip()


def main():
    while True:
        selection = choose()

        if not selection or "Back" in selection:
            break

        if "Show current voice tuning" in selection:
            show_current()

        elif "Set silence duration" in selection:
            set_value(
                "voice.silence_duration",
                "Hermes voice.silence_duration",
                "Enter seconds, for example: 3.0\n"
                "Brownie currently intentionally uses 3.0 seconds.",
            )

        elif "Set silence threshold" in selection:
            set_value(
                "voice.silence_threshold",
                "Hermes voice.silence_threshold",
                "Enter an RMS threshold integer, for example: 1800 or 2400.\n"
                "Higher values make background noise more likely to count as silence.\n"
                "Too high can cause quiet speech to be cut off.",
            )

        elif "Show speaker volume" in selection:
            show_speaker()

        elif "Set speaker volume" in selection:
            set_speaker()

        elif "Show microphone source" in selection:
            show_mic()


if __name__ == "__main__":
    main()
