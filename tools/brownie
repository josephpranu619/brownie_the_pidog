#!/usr/bin/env python3

import argparse
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
CHECK = HERE / "pidog_check.py"


def pause():
    try:
        with open("/dev/tty", "r") as tty:
            print("\nPress Enter to return to Brownie...", end="", flush=True)
            tty.readline()
    except Exception:
        pass


def approx_battery_percent(voltage):
    points = [
        (6.00, 0), (6.60, 5), (7.00, 15), (7.20, 30),
        (7.40, 50), (7.60, 65), (7.80, 80), (8.00, 90),
        (8.20, 97), (8.40, 100),
    ]

    if voltage <= points[0][0]:
        return 0
    if voltage >= points[-1][0]:
        return 100

    for (v1, p1), (v2, p2) in zip(points, points[1:]):
        if v1 <= voltage <= v2:
            f = (voltage - v1) / (v2 - v1)
            return round(p1 + f * (p2 - p1))

    return 0


def battery():
    from robot_hat import device

    v = float(device.get_battery_voltage())
    pct = approx_battery_percent(v)

    print(f"\nBattery: {v:.2f} V   (~{pct}% estimated)")

    if v < 6.2:
        print("WARNING: Battery very low. Avoid servo movement.")

    pause()


def motion(action):
    """Run inside a dedicated short-lived hardware-owning process."""
    from pidog import Pidog

    dog = None

    try:
        print("\nInitializing Brownie...")
        dog = Pidog()

        if action == "walk":
            print("Brownie: standing before walk...")
            dog.do_action("stand", speed=65)
            dog.wait_all_done()
            time.sleep(0.4)

            print("Brownie: walking forward...")
            dog.do_action("forward", step_count=2, speed=80)
            dog.wait_all_done()

            print("Brownie: standing...")
            dog.do_action("stand", speed=65)
            dog.wait_all_done()

        else:
            print(f"Brownie: {action}")
            dog.do_action(action, speed=70)
            dog.wait_all_done()

        print("Done.")

    finally:
        if dog is not None:
            dog.close()


def run_motion(action):
    print()
    subprocess.run([
        sys.executable,
        str(Path(__file__).resolve()),
        "--motion",
        action,
    ])
    pause()


def diagnostic(flag=None):
    cmd = [sys.executable, str(CHECK)]

    if flag:
        cmd.append(flag)

    print()
    subprocess.run(cmd)
    pause()


def choose():
    items = [
        "🐕  Stand",
        "🐕  Sit",
        "🐕  Lie down",
        "🐾  Walk forward — stand first, 2 steps",
        "🔋  Battery status",
        "🩺  Diagnostics — passive",
        "📷  Test — camera capture",
        "📏  Test — ultrasonic",
        "👆  Test — dual touch",
        "🔊  Test — speaker",
        "🎤  Test — microphone",
        "🔧  Test — Robot HAT MCU reset",
        "🚪  Exit Brownie control",
    ]

    p = subprocess.run(
        [
            "fzf",
            "--height=80%",
            "--layout=reverse",
            "--border=rounded",
            "--prompt=Brownie > ",
            "--pointer=▶",
            "--marker=✓",
            "--header=Type to search • Enter to run • Esc to exit",
        ],
        input="\n".join(items),
        text=True,
        stdout=subprocess.PIPE,
    )

    if p.returncode != 0:
        return None

    return p.stdout.strip()


def menu():
    try:
        while True:
            selection = choose()

            if not selection:
                break

            if "Walk forward" in selection:
                run_motion("walk")

            elif "Stand" in selection:
                run_motion("stand")

            elif "Sit" in selection:
                run_motion("sit")

            elif "Lie down" in selection:
                run_motion("lie")

            elif "Battery status" in selection:
                battery()

            elif "Diagnostics — passive" in selection:
                diagnostic()

            elif "camera capture" in selection:
                diagnostic("--camera")

            elif "ultrasonic" in selection:
                diagnostic("--ultrasonic")

            elif "dual touch" in selection:
                diagnostic("--touch")

            elif "speaker" in selection:
                diagnostic("--speaker")

            elif "microphone" in selection:
                diagnostic("--mic")

            elif "MCU reset" in selection:
                diagnostic("--mcu-reset")

            elif "Exit Brownie" in selection:
                break

    except KeyboardInterrupt:
        print("\nExiting Brownie controller...")

    print("Brownie controller closed.")


def main():
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument(
        "--motion",
        choices=["stand", "sit", "lie", "walk"],
    )
    args = parser.parse_args()

    if args.motion:
        motion(args.motion)
    else:
        menu()


if __name__ == "__main__":
    main()
