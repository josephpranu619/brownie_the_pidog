#!/usr/bin/env python3

import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
CHECK = HOME / "pidog_check.py"

dog = None
pose = None


def pause():
    try:
        with open("/dev/tty", "r") as tty:
            print("\nPress Enter to return to Brownie...", end="", flush=True)
            tty.readline()
    except Exception:
        pass


def approx_battery_percent(voltage):
    points = [
        (6.00, 0),
        (6.60, 5),
        (7.00, 15),
        (7.20, 30),
        (7.40, 50),
        (7.60, 65),
        (7.80, 80),
        (8.00, 90),
        (8.20, 97),
        (8.40, 100),
    ]

    if voltage <= points[0][0]:
        return 0
    if voltage >= points[-1][0]:
        return 100

    for (v1, p1), (v2, p2) in zip(points, points[1:]):
        if v1 <= voltage <= v2:
            f = (voltage - v1) / (v2 - v1)
            return round(p1 + f * (p2 - p1))

    return 0


def battery():
    from robot_hat import device

    v = float(device.get_battery_voltage())
    pct = approx_battery_percent(v)

    print(f"\nBattery: {v:.2f} V   (~{pct}% estimated)")

    if v < 6.2:
        print("WARNING: Battery very low. Avoid servo movement.")

    pause()


def get_dog():
    global dog

    if dog is None:
        print("\nInitializing Brownie...")
        from pidog import Pidog
        dog = Pidog()
        print("Brownie ready.")

    return dog


def release_dog():
    global dog, pose

    if dog is not None:
        print("\nPausing Brownie's motion controller...")
        dog.close()
        dog = None
        pose = None


def pose_action(name, speed=70):
    global pose

    d = get_dog()

    print(f"\nBrownie: {name}")
    d.do_action(name, speed=speed)
    d.wait_all_done()

    pose = name
    print("Done.")
    pause()


def walk_forward():
    global pose

    d = get_dog()

    # NEVER enter a gait directly from sit/lie/etc.
    print("\nBrownie: standing before walk...")
    d.do_action("stand", speed=65)
    d.wait_all_done()
    time.sleep(0.4)

    print("Brownie: walking forward...")
    d.do_action("forward", step_count=2, speed=80)
    d.wait_all_done()

    print("Brownie: standing...")
    d.do_action("stand", speed=65)
    d.wait_all_done()

    pose = "stand"
    print("Done.")
    pause()


def diagnostic(flag=None):
    # Diagnostics may need GPIO/audio/camera resources that Pidog owns.
    # Release the controller automatically rather than forcing the user
    # to exit the whole palette.
    release_dog()

    cmd = [sys.executable, str(CHECK)]

    if flag:
        cmd.append(flag)

    print()
    subprocess.run(cmd)
    pause()


def choose():
    items = [
        "🐕  Stand",
        "🐕  Sit",
        "🐕  Lie down",
        "🐾  Walk forward — stand first, 2 steps",
        "🔋  Battery status",
        "🩺  Diagnostics — passive",
        "📷  Test — camera capture",
        "📏  Test — ultrasonic",
        "👆  Test — dual touch",
        "🔊  Test — speaker",
        "🎤  Test — microphone",
        "🔧  Test — Robot HAT MCU reset",
        "🚪  Exit Brownie control",
    ]

    p = subprocess.run(
        [
            "fzf",
            "--height=80%",
            "--layout=reverse",
            "--border=rounded",
            "--prompt=Brownie > ",
            "--pointer=▶",
            "--marker=✓",
            "--header=Type to search • Enter to run • Esc to exit",
        ],
        input="\n".join(items),
        text=True,
        stdout=subprocess.PIPE,
    )

    if p.returncode != 0:
        return None

    return p.stdout.strip()


def main():
    global dog

    try:
        while True:
            selection = choose()

            if not selection:
                break

            if "Walk forward" in selection:
                walk_forward()

            elif "Stand" in selection:
                pose_action("stand")

            elif "Sit" in selection:
                pose_action("sit")

            elif "Lie down" in selection:
                pose_action("lie")

            elif "Battery status" in selection:
                battery()

            elif "Diagnostics — passive" in selection:
                diagnostic()

            elif "camera capture" in selection:
                diagnostic("--camera")

            elif "ultrasonic" in selection:
                diagnostic("--ultrasonic")

            elif "dual touch" in selection:
                diagnostic("--touch")

            elif "speaker" in selection:
                diagnostic("--speaker")

            elif "microphone" in selection:
                diagnostic("--mic")

            elif "MCU reset" in selection:
                diagnostic("--mcu-reset")

            elif "Exit Brownie" in selection:
                break

    except KeyboardInterrupt:
        print("\nExiting Brownie controller...")

    finally:
        if dog is not None:
            print("\nClosing Brownie cleanly...")
            dog.close()

        print("Brownie controller closed.")


if __name__ == "__main__":
    main()
