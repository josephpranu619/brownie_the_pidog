#!/usr/bin/env python3

import subprocess


def pause():
    input("\nPress Enter to return...")


def run(cmd):
    print()
    subprocess.run(cmd, check=False)
    pause()


def choose():
    items = [
        "🧠  Hermes — recent logs",
        "📡  Hermes — live logs",
        "🐕  Body controller — recent logs",
        "📡  Body controller — live logs",
        "🎤  Mic/audio service — recent logs",
        "🎚️   Mic diagnostics",
        "🩺  Brownie services — status",
        "⏱️   Voice latency — recent recorder/STT lines",
        "🚪  Back",
    ]

    p = subprocess.run(
        [
            "fzf",
            "--height=80%",
            "--layout=reverse",
            "--border=rounded",
            "--prompt=Brownie Logs > ",
            "--pointer=▶",
            "--header=Select a log view • Enter to open • Esc to return",
        ],
        input="\n".join(items),
        text=True,
        stdout=subprocess.PIPE,
    )

    if p.returncode != 0:
        return None

    return p.stdout.strip()


def main():
    while True:
        selection = choose()

        if not selection or "Back" in selection:
            break

        if "Hermes — recent logs" in selection:
            run([
                "journalctl",
                "--user",
                "-u",
                "brownie-hermes.service",
                "-n",
                "120",
                "--no-pager",
            ])

        elif "Hermes — live logs" in selection:
            print("\nLive Hermes logs — press Ctrl+C to stop.\n")
            subprocess.run([
                "journalctl",
                "--user",
                "-u",
                "brownie-hermes.service",
                "-f",
            ])

        elif "Body controller — recent logs" in selection:
            run([
                "journalctl",
                "--user",
                "-u",
                "brownie-bodyd.service",
                "-n",
                "120",
                "--no-pager",
            ])

        elif "Body controller — live logs" in selection:
            print("\nLive body-controller logs — press Ctrl+C to stop.\n")
            subprocess.run([
                "journalctl",
                "--user",
                "-u",
                "brownie-bodyd.service",
                "-f",
            ])

        elif "Mic/audio service — recent logs" in selection:
            run([
                "journalctl",
                "--user",
                "-u",
                "brownie-mic.service",
                "-n",
                "120",
                "--no-pager",
            ])

        elif "Mic diagnostics" in selection:
            print("\nBrownie microphone diagnostics")
            print("-------------------------------")

            print("\nSource (Brownie-created):")
            print("  brownie_mic_boosted")
            print('  PulseAudio input source wrapping the PiDog ALSA device "mic".')

            print("\nDefault input source:")
            subprocess.run(["pactl", "get-default-source"], check=False)

            print("\nHardware microphone gain:")
            subprocess.run(
                ["amixer", "-c", "1", "sget", "robot-hat mic"],
                check=False,
            )
            print("  This is the VoiceHAT hardware capture gain.")
            print("  Brownie currently uses 100% / +25 dB, the hardware maximum.")

            print("\nSoftware input volume:")
            subprocess.run(
                ["pactl", "get-source-volume", "brownie_mic_boosted"],
                check=False,
            )
            print("  100% / 0 dB = no extra PulseAudio amplification.")
            print("  Above 100% = software boost; below 100% = attenuation.")

            print("\nMute state:")
            subprocess.run(
                ["pactl", "get-source-mute", "brownie_mic_boosted"],
                check=False,
            )
            print('  "no" means microphone audio is allowed through.')

            print("\nSource state:")
            subprocess.run(
                [
                    "bash",
                    "-lc",
                    "pactl list short sources | grep brownie_mic_boosted || true",
                ],
                check=False,
            )

            print("\nLive RMS meter")
            print("--------------")
            print("Brownie's current observed reference:")
            print("  ~30–100     quiet room")
            print("  ~700–1800   normal nearby speech")
            print("  >300 idle   investigate background noise")
            print()
            print("RMS = approximate instantaneous audio energy.")
            print("Higher number = louder signal.")
            print("\nSpeak normally; Ctrl+C to stop.")
            try:
                subprocess.run(
                    [
                        "/home/pranu/.hermes/hermes-agent/venv/bin/python",
                        "-c",
                        (
                            "import sounddevice as sd, numpy as np; "
                            "cb=lambda indata,frames,time_info,status: print(int(np.sqrt(np.mean(indata.astype(np.float64)**2))), flush=True); "
                            "s=sd.InputStream(channels=1, samplerate=16000, blocksize=1600, "
                            "dtype='int16', callback=cb); "
                            "s.start(); "
                            "import time, signal, sys; "
                            "signal.signal(signal.SIGINT, lambda sig, frame: sys.exit(0)); "
                            "time.sleep(3600)"
                        ),
                    ],
                    check=False,
                )
            except KeyboardInterrupt:
                pass

            pause()

        elif "Brownie services — status" in selection:
            run([
                "systemctl",
                "--user",
                "status",
                "brownie-mic.service",
                "brownie-bodyd.service",
                "brownie-hermes.service",
                "--no-pager",
            ])

        elif "Voice latency — recent recorder/STT lines" in selection:
            print()
            subprocess.run(
                [
                    "journalctl",
                    "--user",
                    "-u",
                    "brownie-hermes.service",
                    "-n",
                    "300",
                    "--no-pager",
                ],
                stdout=subprocess.PIPE,
                text=True,
                check=False,
            )
            p = subprocess.run(
                [
                    "journalctl",
                    "--user",
                    "-u",
                    "brownie-hermes.service",
                    "-n",
                    "300",
                    "--no-pager",
                ],
                stdout=subprocess.PIPE,
                text=True,
                check=False,
            )

            keywords = (
                "Recording",
                "recording",
                "Silence detected",
                "transcribing",
                "Transcrib",
                "Wake word",
                "skill",
                "pidog_action",
            )

            found = False

            for line in p.stdout.splitlines():
                if any(k in line for k in keywords):
                    print(line)
                    found = True

            if not found:
                print("No matching latency-related lines found.")

            pause()


if __name__ == "__main__":
    main()
